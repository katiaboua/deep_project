    "def value_iteration_track(model_S, model_A, model_R, model_p, model_T, gamma=0.99, theta=0.001):\n",
    "    V = np.random.random(len(model_S))\n",
    "    V[model_T] = 0.0\n",
    "    V_history = [V.copy()]\n",
    "\n",
    "    while True:\n",
    "        delta = 0.0\n",
    "        for s_index in range(len(model_S)):\n",
    "            v = V[s_index]\n",
    "            best_value = None\n",
    "            for a_index in range(len(model_A)):\n",
    "                total = 0.0\n",
    "                for s_p_index in range(len(model_S)):\n",
    "                    for r_index in range(len(model_R)):\n",
    "                        total += model_p[s_index, a_index, s_p_index, r_index] * (\n",
    "                            model_R[r_index] + gamma * V[s_p_index]\n",
    "                        )\n",
    "                if best_value is None or total > best_value:\n",
    "                    best_value = total\n",
    "            V[s_index] = best_value\n",
    "            delta = np.maximum(delta, np.abs(best_value - v))\n",
    "        V_history.append(V.copy())\n",
    "        if delta < theta:\n",
    "            break\n",
    "\n",
    "    return V, V_history\n",
    "\n",
    "V_final, V_history = value_iteration_track(S, A, R, p, T)\n",
    "print(f\"Convergence en {len(V_history)} itérations\")\n",
    "\n",
    "# Afficher quelques itérations clés\n",
    "iterations_to_show = [0, 1, 2, len(V_history)//2, len(V_history)-1]\n",
    "fig, axes = plt.subplots(1, len(iterations_to_show), figsize=(20, 4))\n",
    "\n",
    "for ax, i in zip(axes, iterations_to_show):\n",
    "    im = ax.imshow(V_history[i].reshape(5,5), cmap='RdYlGn', vmin=-1, vmax=1)\n",
    "    for row in range(5):\n",
    "        for col in range(5):\n",
    "            s = row * 5 + col\n",
    "            ax.text(col, row, f'{V_history[i][s]:.2f}',\n",
    "                   ha='center', va='center', fontsize=7)\n",
    "    ax.set_title(f'Itération {i}')\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "\n",
    "plt.suptitle(f'Propagation de V — GridWorld ({len(V_history)} itérations)', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.savefig('gridworld_propagation.png', dpi=100, bbox_inches='tight')\n",
    "plt.close()"
   ]
  },
