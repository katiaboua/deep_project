    "import time\n",
    "from environments.grid_world import GridWorldEnv\n",
    "from algorithms.monte_carlo import monte_carlo_es, on_policy_first_visit_mc_control, off_policy_mc_control\n",
    "from algorithms.temporal_difference_learning import sarsa, q_learning\n",
    "from algorithms.planning import dyna_q, dyna_q_plus\n",
    "\n",
    "print(\"=== Tous les algos sur GridWorld ===\\n\")\n",
    "ACTION_NAMES = {0:'H', 1:'B', 2:'G', 3:'D'}\n",
    "\n",
    "algos_gw = {\n",
    "    'Monte Carlo ES': lambda: monte_carlo_es(GridWorldEnv(), num_episodes=1000),\n",
    "    'On-policy MC':   lambda: on_policy_first_visit_mc_control(GridWorldEnv(), num_episodes=1000),\n",
    "    'Off-policy MC':  lambda: off_policy_mc_control(GridWorldEnv(), num_episodes=1000),\n",
    "    'Sarsa':          lambda: sarsa(GridWorldEnv(), num_episodes=1000),\n",
    "    'Q-Learning':     lambda: q_learning(GridWorldEnv(), num_episodes=1000),\n",
    "    'Dyna-Q':         lambda: dyna_q(GridWorldEnv(), max_steps=1000),\n",
    "    'Dyna-Q+':        lambda: dyna_q_plus(GridWorldEnv(), max_steps=1000),\n",
    "}\n",
    "\n",
    "results_gw = {}\n",
    "for name, algo in algos_gw.items():\n",
    "    t = time.time()\n",
    "    pi, Q = algo()\n",
    "    t = time.time() - t\n",
    "    print(f\"{name} | temps={t:.3f}s\")\n",
    "    results_gw[name] = (pi, Q, t)"
   ]
  }
